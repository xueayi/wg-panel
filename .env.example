# 复制为 .env 后填写；.env 已在 .gitignore 里，永不入库
#
# 面板只需要这三个（节点地址、SSH 凭证都在面板「连接设置」里填）：
WGP_ADMIN_PASSWORD=__ADMIN_PASSWORD__     # 首次启动初始化 admin 账号；不填则 admin/admin
WGP_SECRET_KEY=__SECRET_KEY__             # openssl rand -hex 32
WGP_DATA_DIR=./data

# 本机开发时用假节点，不碰任何真实资源：
# WGP_DRIVER=mock

# ── 以下是节点连接参数：都可不设 ──
# 推荐在面板「连接设置」里填（值会存进面板数据库并覆盖这里的初始值）；
# 想在启动时就把值灌进去，再取消注释：
# WGP_DRIVER=ssh
# WGP_SSH_HOST=203.0.113.10          # 中转节点地址
# WGP_SSH_PORT=22
# WGP_SSH_USER=root                  # 需能读写 /etc/wireguard
# WGP_SSH_AUTH=key                   # key | password
# WGP_SSH_KEY=/ssh/id_ed25519        # 密钥认证时的私钥路径（也可在面板里粘贴上传）
# WGP_SSH_REMOTE_TOOL=/root/wireguard/wgagent.py
# WGP_IFACE=wg0
# WGP_READ_ONLY=0                    # 1 = 只读模式
