# 复制为 .env 后填写；.env 已在 .gitignore 里，永不入库
# 容器内同名变量优先级更高，这里只是本机开发用

WGP_DRIVER=mock          # mock=开发演示 | ssh=纳管真实中转节点
WGP_READ_ONLY=0          # 1=只读模式（看得到、改不了）

# ── SSH 驱动（WGP_DRIVER=ssh 时必填）──
WGP_SSH_HOST=203.0.113.10
WGP_SSH_USER=root
WGP_SSH_PORT=22
WGP_SSH_KEY=/ssh/id_ed25519
WGP_SSH_REMOTE_TOOL=/root/wireguard/wgagent.py
WGP_IFACE=wg0

# ── 面板自身 ──
WGP_ADMIN_PASSWORD=__ADMIN_PASSWORD__
WGP_SECRET_KEY=__SECRET_KEY__
WGP_SESSION_HOURS=12
WGP_DATA_DIR=./data
