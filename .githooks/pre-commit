#!/bin/sh
# 提交前脱敏拦截：私钥块 / 容器仓库令牌 / 公网 IP / 超长 base64（WireGuard 密钥形状）
# 启用：git config core.hooksPath .githooks
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0
report() { printf '✖ 疑似敏感内容  %s\n   %s\n' "$1" "$2"; fail=1; }

# 只扫描文本文件，跳过二进制
files=$(printf '%s\n' "$staged" | while read -r f; do
  [ -f "$f" ] || continue
  case "$f" in *.png|*.jpg|*.webp|*.ico|*.woff*|*.zip) continue;; esac
  printf '%s\n' "$f"
done)

for f in $files; do
  # 1. 私钥块
  if grep -nE "BEGIN (OPENSSH|RSA|EC|DSA|PRIVATE) PRIVATE KEY" "$f" >/dev/null 2>&1; then
    report "$f" "$(grep -nE 'BEGIN .*PRIVATE KEY' "$f" | head -1)"
  fi
  # 2. Docker Hub / 常见令牌形状
  if grep -nE "dckr_(pat_)?[A-Za-z0-9_-]{10,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}" "$f" >/dev/null 2>&1; then
    report "$f" "$(grep -nEo 'dckr_(pat_)?[A-Za-z0-9_-]{10,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}' "$f" | head -1)"
  fi
  # 3. 公网 IPv4：排除 RFC1918 / 回环 / 文档保留段（TEST-NET 用于示例）
  if grep -nEo '([0-9]{1,3}\.){3}[0-9]{1,3}' "$f" 2>/dev/null | grep -vE '(^|:)(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|127\.|0\.|198\.51\.100\.|203\.0\.113\.|2001:db8)' | head -1 | grep -q .; then
    hit=$(grep -nEo '([0-9]{1,3}\.){3}[0-9]{1,3}' "$f" | grep -vE '(^|:)(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|127\.|0\.|198\.51\.100\.|203\.0\.113\.|2001:db8)' | head -1)
    report "$f" "公网 IP $hit"
  fi
  # 4. WireGuard 密钥形状的长 base64（44 字符且大小写混合），排除占位符
  if grep -nE "[A-Za-z0-9+/]{44}={0,1}" "$f" 2>/dev/null | grep -vE "example|<base64>|REDACTED|占位" | head -1 | grep -q .; then
    hit=$(grep -nEo '[A-Za-z0-9+/]{44}={0,1}' "$f" | head -1)
    if printf '%s' "$hit" | grep -q '[a-z]' && printf '%s' "$hit" | grep -q '[A-Z]'; then
      report "$f" "疑似密钥 $hit"
    fi
  fi
done

if [ "$fail" -ne 0 ]; then
  printf '\n提交已中止。确认是示例值就写成占位符（如 203.0.113.10 / <base64>），或 git commit --no-verify 绕过。\n'
  exit 1
fi
exit 0
